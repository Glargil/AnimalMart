@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}
<div class="row justify-content-center">
    <div class="col-md-4">
        <h1>@ViewData["Title"]</h1>

        <form method="post">
            <div class="mb-3">
    <label asp-for="Credentials.Email" class="form-label">Email</label>
    <input asp-for="Credentials.Email" type="email" class="form-control" />
</div>
<div class="mb-3">
    <label asp-for="Credentials.Password" class="form-label">Password</label>
    <input asp-for="Credentials.Password" type="password" class="form-control" />
</div>
            <button type="submit" class="btn btn-primary">Log in</button>
            <a asp-page="/ForgotPassword" class="btn btn-link">Forgot your password?</a>
        </form>
    </div>

</div>
