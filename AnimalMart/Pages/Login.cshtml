@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}
<div class="am-auth">
    <div class="am-auth-card">
        <h1 class="am-auth-card__title">@ViewData["Title"]</h1>

        <form method="post">
            <div class="am-field">
                <label asp-for="Credentials.Email" class="am-field__label">Email</label>
                <input asp-for="Credentials.Email" type="email" class="am-field__input" />
            </div>
            <div class="am-field">
                <label asp-for="Credentials.Password" class="am-field__label">Password</label>
                <input asp-for="Credentials.Password" type="password" class="am-field__input" />
            </div>
            <button type="submit" class="am-btn am-btn--primary am-btn--block">Log in</button>
            <a asp-page="/ForgotPassword" class="am-link-muted">Forgot your password?</a>
            </br>
            <a asp-page="/CreateUser" clas "am-link-muted"> Sign Up</a>
    </form>
    </div>
</div>
