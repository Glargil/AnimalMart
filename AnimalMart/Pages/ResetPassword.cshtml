@page
@model AnimalMart.Pages.ResetPasswordModel
@{
}

@* This page's URL carries a secret token in the query string, so: don't let
   it be indexed/cached, and don't leak it via Referer if a future change
   adds any external resource (font/CDN/etc.) to this page. *@
<meta name="robots" content="noindex, nofollow" />
<meta name="referrer" content="no-referrer" />

<div class="am-auth">
    <div class="am-auth-card">
        <h1 class="am-auth-card__title">Reset your password</h1>

        @if (Model.Success)
        {
            <p class="am-auth-card__text">Your password has been changed. You can now sign in with your new password.</p>
            <a asp-page="/Login" class="am-btn am-btn--primary am-btn--block">Go to login</a>
        }
        else if (Model.LinkInvalid)
        {
            <p class="am-auth-card__text">This password reset link is invalid or has expired.</p>
            <a asp-page="/ForgotPassword" class="am-btn am-btn--primary am-btn--block">Request a new link</a>
        }
        else
        {
            <form method="post">
                <input type="hidden" asp-for="Token" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="am-field">
                    <label asp-for="NewPassword" class="am-field__label"></label>
                    <input asp-for="NewPassword" type="password" id="passwordInput" autocomplete="new-password" class="am-field__input" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>

                    <div class="strength-bar mt-2">
                        <div id="strengthFill"></div>
                    </div>
                    <span id="strengthLabel" class="text-muted"></span>
                </div>

                <div class="am-field">
                    <label asp-for="ConfirmPassword" class="am-field__label"></label>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" class="am-field__input" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="am-btn am-btn--primary am-btn--block">Reset password</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const input = document.getElementById('passwordInput');
        const fill = document.getElementById('strengthFill');
        const label = document.getElementById('strengthLabel');
        let debounceTimer;

        input.addEventListener('input', () => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(checkPassword, 300);
        });

        async function checkPassword() {
            const response = await fetch(
                `?handler=Score&password=${encodeURIComponent(input.value)}`);
            const result = await response.json();

            fill.style.width = result.score + '%';
            fill.style.backgroundColor =
                result.score < 40 ? '#e74c3c' :
                result.score < 70 ? '#f39c12' : '#2ecc71';

            label.textContent = result.score < 40 ? 'Svagt'
                : result.score < 70 ? 'Middel'
                : 'Stærkt';
        }
    </script>
}
