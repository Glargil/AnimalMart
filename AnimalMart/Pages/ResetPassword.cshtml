@page
@model AnimalMart.Pages.ResetPasswordModel
@{
    <style>
        .strength-bar {
            width: 100%;
            height: 8px;
            background: #dee2e6;
            border-radius: 4px;
            overflow: hidden;
        }
        #strengthFill {
            height: 100%;
            width: 0%;
            background: #e74c3c;
            border-radius: 4px;
            transition: width 0.3s ease, background-color 0.3s ease;
        }
    </style>
}

@* This page's URL carries a secret token in the query string, so: don't let
   it be indexed/cached, and don't leak it via Referer if a future change
   adds any external resource (font/CDN/etc.) to this page. *@
<meta name="robots" content="noindex, nofollow" />
<meta name="referrer" content="no-referrer" />

<h1>Reset your password</h1>

@if (Model.Success)
{
    <p>Your password has been changed. You can now sign in with your new password.</p>
    <a asp-page="/Login">Go to login</a>
}
else if (Model.LinkInvalid)
{
    <p>This password reset link is invalid or has expired.</p>
    <a asp-page="/ForgotPassword">Request a new link</a>
}
else
{
    <form method="post">
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="ModelOnly"></div>

        <div>
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" type="password" id="passwordInput" autocomplete="new-password" />
            <span asp-validation-for="NewPassword"></span>

            <div class="strength-bar mt-2">
                <div id="strengthFill"></div>
            </div>
            <span id="strengthLabel" class="text-muted"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <button type="submit">Reset password</button>
    </form>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const input = document.getElementById('passwordInput');
        const fill = document.getElementById('strengthFill');
        const label = document.getElementById('strengthLabel');
        let debounceTimer;

        input.addEventListener('input', () => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(checkPassword, 300);
        });

        async function checkPassword() {
            const response = await fetch(
                `?handler=Score&password=${encodeURIComponent(input.value)}`);
            const result = await response.json();

            fill.style.width = result.score + '%';
            fill.style.backgroundColor =
                result.score < 40 ? '#e74c3c' :
                result.score < 70 ? '#f39c12' : '#2ecc71';

            label.textContent = result.score < 40 ? 'Svagt'
                : result.score < 70 ? 'Middel'
                : 'Stærkt';
        }
    </script>
}
