@page
@model AnimalMart.Pages.Admin.CreateProductModel
@{
    ViewData["Title"] = "Create Product";
}

<h1>Create Product</h1>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<div class="row">
    <div class="col-md-6">
        <h2>Add animal</h2>
        @if (Model.AnimalError != null)
        {
            <div class="alert alert-danger">@Model.AnimalError</div>
        }
        <form method="post" asp-page-handler="AddAnimal" enctype="multipart/form-data">
            <div class="mb-2">
                <label asp-for="Animal.Name" class="form-label"></label>
                <input asp-for="Animal.Name" class="form-control" />
            </div>
            <div class="mb-2">
                <label asp-for="Animal.Description" class="form-label"></label>
                <textarea asp-for="Animal.Description" class="form-control"></textarea>
            </div>
            <div class="mb-2">
                <label asp-for="Animal.Price" class="form-label"></label>
                <input asp-for="Animal.Price" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <div class="mb-2">
                <label asp-for="Animal.Sex" class="form-label"></label>
                <select asp-for="Animal.Sex" class="form-select">
                    <option value="">-- choose --</option>
                    <option>Male</option>
                    <option>Female</option>
                    <option>Unknown</option>
                </select>
            </div>
            <div class="mb-2">
                <label asp-for="Animal.Species" class="form-label"></label>
                <input asp-for="Animal.Species" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Animal.BirthDay" class="form-label"></label>
                <input asp-for="Animal.BirthDay" type="date" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Animal.Image" class="form-label">Image (optional)</label>
                <input asp-for="Animal.Image" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Save animal</button>
        </form>
    </div>

    <div class="col-md-6">
        <h2>Add item</h2>
        @if (Model.ItemError != null)
        {
            <div class="alert alert-danger">@Model.ItemError</div>
        }
        <form method="post" asp-page-handler="AddItem" enctype="multipart/form-data">
            <div class="mb-2">
                <label asp-for="Item.Name" class="form-label"></label>
                <input asp-for="Item.Name" class="form-control" />
            </div>
            <div class="mb-2">
                <label asp-for="Item.Description" class="form-label"></label>
                <textarea asp-for="Item.Description" class="form-control"></textarea>
            </div>
            <div class="mb-2">
                <label asp-for="Item.Price" class="form-label"></label>
                <input asp-for="Item.Price" type="number" step="0.01" min="0" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Item.Stock" class="form-label"></label>
                <input asp-for="Item.Stock" type="number" min="0" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Item.Image" class="form-label">Image (optional)</label>
                <input asp-for="Item.Image" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Save item</button>
        </form>
    </div>
</div>

<hr />

<div class="row">
    <div class="col-md-6">
        <h3>Animals in database (@Model.Animals.Count)</h3>
        <table class="table table-sm">
            <thead><tr><th>Id</th><th>Image</th><th>Name</th><th>Species</th><th>Sex</th><th>Birthday</th><th>Price</th><th></th></tr></thead>
            <tbody>
                @foreach (var a in Model.Animals)
                {
                    <tr>
                        <td>@a.Id</td>
                        <td>@if (a.ImgPath != null) { <img src="@a.ImgPath" alt="@a.Name" width="40" height="40" style="object-fit: cover" /> }</td>
                        <td>@a.Name</td>
                        <td>@a.Species</td>
                        <td>@a.Sex</td>
                        <td>@a.BirthDay</td>
                        <td>@a.Price</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" asp-page="EditAnimal" asp-route-id="@a.Id">Edit</a>
                                <form method="post" asp-page-handler="DeleteAnimal" class="d-inline">
                                    <input type="hidden" name="id" value="@a.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-md-6">
        <h3>Items in database (@Model.Items.Count)</h3>
        <table class="table table-sm">
            <thead><tr><th>Id</th><th>Image</th><th>Name</th><th>Stock</th><th>Price</th><th></th></tr></thead>
            <tbody>
                @foreach (var i in Model.Items)
                {
                    <tr>
                        <td>@i.Id</td>
                        <td>@if (i.ImgPath != null) { <img src="@i.ImgPath" alt="@i.Name" width="40" height="40" style="object-fit: cover" /> }</td>
                        <td>@i.Name</td>
                        <td>@i.Stock</td>
                        <td>@i.Price</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" asp-page="EditItem" asp-route-id="@i.Id">Edit</a>
                                <form method="post" asp-page-handler="DeleteItem" class="d-inline">
                                    <input type="hidden" name="id" value="@i.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>