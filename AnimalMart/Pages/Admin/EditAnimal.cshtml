@page
@model AnimalMart.Pages.Admin.EditAnimalModel
@{
    ViewData["Title"] = "Edit Animal";
}

<h1>Edit animal #@Model.Id</h1>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}

<form method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-2">
        <label asp-for="Animal.Name" class="form-label"></label>
        <input asp-for="Animal.Name" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Animal.Description" class="form-label"></label>
        <textarea asp-for="Animal.Description" class="form-control"></textarea>
    </div>
    <div class="mb-2">
        <label asp-for="Animal.Price" class="form-label"></label>
        <input asp-for="Animal.Price" type="number" step="0.01" min="0" class="form-control" />
    </div>
    <div class="mb-2">
        <label asp-for="Animal.Sex" class="form-label"></label>
        <select asp-for="Animal.Sex" class="form-select">
            <option value="">-- choose --</option>
            <option>Male</option>
            <option>Female</option>
            <option>Unknown</option>
        </select>
    </div>
    <div class="mb-2">
        <label asp-for="Animal.Species" class="form-label"></label>
        <input asp-for="Animal.Species" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Animal.BirthDay" class="form-label"></label>
        <input asp-for="Animal.BirthDay" type="date" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a asp-page="CreateProduct" class="btn btn-secondary">Cancel</a>
</form>