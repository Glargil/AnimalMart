<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AnimalMart</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AnimalMart.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="am-header">
        <div class="am-header__inner">
            <a class="am-logo" asp-area="" asp-page="/Index">AnimalMart</a>
            <nav class="am-nav">
                <ul class="am-nav__list">
                    <li>
                        <a class="am-nav__link" asp-area="" asp-page="/CreateUser">Create User</a>
                    </li>
                    <li>
                        <a class="am-nav__link" asp-area="" asp-page="/Admin/CreateProduct">Create Product</a>
                    </li>
                    <li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="am-nav__link am-nav__icon" asp-area="" asp-page="/Profile" aria-label="Profile">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="8" r="4" />
                                    <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" />
                                </svg>
                            </a>
                        }
                        else
                        {
                            <a class="am-nav__link am-nav__icon" asp-area="" asp-page="/Login" aria-label="Login">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="8" r="4" />
                                    <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" />
                                </svg>
                            </a>
                        }
                    </li>
                </ul>
            </nav>
        </div>
    </header>
    <div class="container am-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="am-footer">
        <div class="am-footer__inner">
            &copy; 2026 - AnimalMart - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
