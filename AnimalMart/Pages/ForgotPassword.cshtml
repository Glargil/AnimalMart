@page
@model AnimalMart.Pages.ForgotPasswordModel
@{
}

<div class="am-auth">
    <div class="am-auth-card">
        <h1 class="am-auth-card__title">Forgot your password?</h1>

        @if (Model.Submitted)
        {
            <p class="am-auth-card__text">
                If an account exists for that email address, we've sent a link to reset
                your password. The link expires in 15 minutes.
            </p>
        }
        else
        {
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="am-field">
                    <label asp-for="Email" class="am-field__label"></label>
                    <input asp-for="Email" autocomplete="email" class="am-field__input" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <button type="submit" class="am-btn am-btn--primary am-btn--block">Send reset link</button>
            </form>
        }
    </div>
</div>
