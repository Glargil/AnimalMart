@page
@model OrderHistoryModel
@{
    ViewData["Title"] = "Order history";
}

<h1>Order history</h1>

@if (Model.Orders.Count == 0)
{
    <p class="text-muted">You have no orders yet.</p>
    <a asp-page="Index">Browse products</a>
}
else
{
    @foreach (var order in Model.Orders)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between flex-wrap">
                <span>Order #@order.Id</span>
                <span>@order.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                <span>@order.PaymentMethod</span>
                <span>@order.Total.ToString("0.00") kr.</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit price</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in order.Lines)
                        {
                            <tr>
                                <td>@line.ProductName</td>
                                <td class="text-end">@line.Quantity</td>
                                <td class="text-end">@line.UnitPrice.ToString("0.00") kr.</td>
                                <td class="text-end">@line.LineTotal.ToString("0.00") kr.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}