@page
@model AnimalMart.Pages.CreateUserModel
@{
    ViewData["Title"] = "Create User";
}

<div class="am-auth">
    <div class="am-auth-card">
        <h1 class="am-auth-card__title">Create User</h1>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="am-field">
                <label asp-for="NewUser.Name" class="am-field__label"></label>
                <input asp-for="NewUser.Name" class="am-field__input" />
                <span asp-validation-for="NewUser.Name" class="text-danger"></span>
            </div>

            <div class="am-field">
                <label asp-for="NewUser.Email" class="am-field__label"></label>
                <input asp-for="NewUser.Email" class="am-field__input" />
                <span asp-validation-for="NewUser.Email" class="text-danger"></span>
            </div>

            <div class="am-field">
                <label asp-for="NewUser.PhoneNumber" class="am-field__label"></label>
                <input asp-for="NewUser.PhoneNumber" class="am-field__input" />
                <span asp-validation-for="NewUser.PhoneNumber" class="text-danger"></span>
            </div>

            <div class="am-field">
                <label asp-for="NewUser.Password" class="am-field__label"></label>
                <input asp-for="NewUser.Password" type="password" class="am-field__input" id="passwordInput" />
                <span asp-validation-for="NewUser.Password" class="text-danger"></span>

                <div class="strength-bar mt-2">
                    <div id="strengthFill"></div>
                </div>
                <span id="strengthLabel" class="text-muted"></span>
            </div>

            <button type="submit" class="am-btn am-btn--primary am-btn--block">Create User</button>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");

    }
    <script>
        const input = document.getElementById('passwordInput');
        const fill = document.getElementById('strengthFill');
        const label = document.getElementById('strengthLabel');
        let debounceTimer;

        input.addEventListener('input', () => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(checkPassword, 300);
        });

        async function checkPassword() {
            const name = document.getElementById('NewUser_Name');
            const response = await fetch(
                `?handler=Score&password=${encodeURIComponent(input.value)}` +
                `&username=${encodeURIComponent(name ? name.value : '')}`);
            const result = await response.json();

            fill.style.width = result.score + '%';
            fill.style.backgroundColor =
                result.score < 40 ? '#e74c3c' :
                result.score < 70 ? '#f39c12' : '#2ecc71';

            label.textContent = result.score < 40 ? 'Svagt'
                : result.score < 70 ? 'Middel'
                : 'Stærkt';
        }
    </script>
}